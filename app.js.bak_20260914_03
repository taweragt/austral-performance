  current: {
    title: "Atenção no Google. <span>Meta evoluiu.</span>",
    status: "Atenção",
    statusCopy: "O CPL do Google subiu 35,8% enquanto os formulários caíram 10%. No Meta, o CPL registrado caiu 33,3%.",
    meta: { cpl: "R$ 14,20", cplDelta: "33,3%", visits: "255", visitsDelta: "10,4%", followers: "4.016", followersDelta: "1,7%", newFollowers: "68", newFollowersDelta: "353,3%" },
    google: { leads: "45", leadsDelta: "10,0%", cpl: "R$ 26,03", cplDelta: "35,8%", spend: "R$ 1.171,55", spendDelta: "22,2%", insight: "R$ 213,06 a mais para gerar 5 formulários a menos." }
  },
  previous: {
