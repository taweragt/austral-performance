    status: "Referência",
    statusCopy: "Período usado como base de comparação. O Google gerou 50 formulários com CPL de R$ 19,17.",
    meta: { cpl: "R$ 21,29", cplDelta: "base", visits: "231", visitsDelta: "base", followers: "3.948", followersDelta: "base", newFollowers: "15", newFollowersDelta: "base" },
    google: { leads: "50", leadsDelta: "base", cpl: "R$ 19,17", cplDelta: "base", spend: "R$ 958,49", spendDelta: "base", insight: "Esta é a semana-base usada nas comparações do período seguinte." }
  }
};

const byId = id => document.getElementById(id);
const defaultAdLinks = {
  current: "https://www.instagram.com/p/Dc3CrOSj3Qd/",
  previous: ""
};
let selectedWeek = "current";

function setDelta(id, value) {
  const element = byId(id);
  const svg = element.querySelector("svg");
  element.replaceChildren(svg, document.createTextNode(value));
}

function renderWeek(key) {
  selectedWeek = key;
  const data = weeks[key];
  byId("status-title").innerHTML = data.title;
  byId("status-copy").textContent = data.statusCopy;
  byId("status-pill").textContent = data.status;

  byId("meta-cpl").textContent = data.meta.cpl;
  byId("meta-visits").textContent = data.meta.visits;
  byId("followers").textContent = data.meta.followers;
  byId("new-followers").textContent = data.meta.newFollowers;
  setDelta("meta-cpl-delta", data.meta.cplDelta);
  setDelta("meta-visits-delta", data.meta.visitsDelta);
  setDelta("followers-delta", data.meta.followersDelta);
  setDelta("new-followers-delta", data.meta.newFollowersDelta);

  byId("google-leads").textContent = data.google.leads;
  byId("google-cpl").textContent = data.google.cpl;
  byId("google-spend").textContent = data.google.spend;
  setDelta("google-leads-delta", data.google.leadsDelta);
  setDelta("google-cpl-delta", data.google.cplDelta);
  setDelta("google-spend-delta", data.google.spendDelta);
  byId("google-insight").textContent = data.google.insight;
  renderAdLink();
}

byId("week-select").addEventListener("change", event => renderWeek(event.target.value));

const actionList = byId("action-list");
const pendingCount = byId("pending-count");

function updatePendingCount() {
  const total = actionList.querySelectorAll("input[type='checkbox']").length;
  const completed = actionList.querySelectorAll("input[type='checkbox']:checked").length;
  const pending = total - completed;
  pendingCount.textContent = `${pending} ${pending === 1 ? "pendente" : "pendentes"}`;
}

actionList.addEventListener("change", updatePendingCount);

byId("quick-action-form").addEventListener("submit", event => {
  event.preventDefault();
  const input = byId("quick-action");
  const title = input.value.trim();
  if (!title) return input.focus();

  const label = document.createElement("label");
  label.className = "action-item";
  label.innerHTML = '<input type="checkbox"><span class="check-box" aria-hidden="true"></span><span><strong></strong><small>Adicionada nesta reunião</small></span>';
  label.querySelector("strong").textContent = title;
  actionList.append(label);
  input.value = "";
  updatePendingCount();
});

const quickNotes = byId("quick-notes");
quickNotes.value = localStorage.getItem("4medic-v2-quick-notes") || "";
quickNotes.addEventListener("input", () => localStorage.setItem("4medic-v2-quick-notes", quickNotes.value));

const adLinkForm = byId("ad-link-form");
const adLinkInput = byId("ad-link-input");
const adLinkFeedback = byId("ad-link-feedback");
const adOpen = byId("ad-open");
const adPreviewLink = byId("ad-preview-link");
const adUrlDisplay = byId("ad-url-display");

function adStorageKey() {
  return `4medic-v2-ad-link-${selectedWeek}`;
}

function getAdLink() {
  const stored = localStorage.getItem(adStorageKey());
  return stored === null ? defaultAdLinks[selectedWeek] : stored;
}

function shortUrl(url) {
  if (!url) return "Nenhum link adicionado";
  const parsed = new URL(url);
  return `${parsed.hostname.replace(/^www\./, "")}${parsed.pathname}`.replace(/\/$/, "");
}

function renderAdLink() {
  const url = getAdLink();
  [adOpen, adPreviewLink, adUrlDisplay].forEach(element => {
    element.setAttribute("aria-disabled", String(!url));
    if (url) element.href = url;
    else element.removeAttribute("href");
  });
  adUrlDisplay.textContent = shortUrl(url);
  adLinkInput.value = url;
  adLinkFeedback.textContent = "";
  adLinkFeedback.classList.remove("success");
  adLinkForm.hidden = true;
}

byId("edit-ad-link").addEventListener("click", () => {
  adLinkForm.hidden = !adLinkForm.hidden;
  adLinkFeedback.textContent = "";
  if (!adLinkForm.hidden) {
    adLinkInput.value = getAdLink();
    adLinkInput.focus();
    adLinkInput.select();
  }
});

adLinkForm.addEventListener("submit", event => {
  event.preventDefault();
  const value = adLinkInput.value.trim();
  if (!value) {
    adLinkFeedback.textContent = "Cole um link antes de salvar.";
    adLinkInput.focus();
    return;
  }

  try {
    const parsed = new URL(value);
    if (!['http:', 'https:'].includes(parsed.protocol)) throw new Error('invalid protocol');
    localStorage.setItem(adStorageKey(), parsed.href);
    renderAdLink();
    adLinkForm.hidden = false;
    adLinkFeedback.textContent = "Link salvo para esta semana.";
    adLinkFeedback.classList.add("success");
  } catch {
    adLinkFeedback.textContent = "Use um link completo, começando com https://";
    adLinkInput.focus();
  }
});

renderAdLink();
