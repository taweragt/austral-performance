const weeks = [
  { key:"2026-08-03", date:"03/08/2026", meta:{leads:7,cpl:31.47,visits:213,followers:3910,newFollowers:15}, google:{leads:10,cpl:45.20,subscribers:1258,newSubscribers:496}, actions:[ ["Impulsionar","Meta · prazo: 14/08"], ["Negativar termos de pesquisa","Google · prazo: 31/07"] ] },
  { key:"2026-08-10", date:"10/08/2026", meta:{leads:6,cpl:33.47,visits:204,followers:3910,newFollowers:3}, google:{leads:19,cpl:49.20,subscribers:1970,newSubscribers:712}, actions:[ ["Impulsionar","Meta · prazo: 14/08"], ["Testar novo conjunto e novas peças","Meta"], ["Conversão de LP ou remarketing de WhatsApp","Meta"], ["Negativar termos de pesquisa","Google · prazo: 14/08"], ["Trocar vídeos da campanha de seguidor","Google"], ["Aumentar gradualmente a verba de Search","Google"] ] },
  { key:"2026-08-17", date:"17/08/2026", meta:{leads:11,cpl:18.47,visits:202,followers:3924,newFollowers:10}, google:{leads:21,cpl:35.10,subscribers:1970,newSubscribers:612}, actions:[ ["Impulsionar","Meta · prazo: 21/08"], ["Testar novo conjunto e novas peças","Meta"], ["Conversão de LP ou remarketing de WhatsApp","Meta"], ["Negativar termos de pesquisa","Google · prazo: 20/08"], ["Fazer diagnóstico da conta","Google"], ["Aumentar gradualmente a verba de Search","Google"] ], note:"Dia da otimização de saldo: média registrada de 59,34 leads a R$ 42,27." },
  { key:"2026-08-24", date:"24/08/2026", meta:{leads:8,cpl:23.74,visits:215,followers:3933,newFollowers:9}, google:{leads:41,cpl:24.10,subscribers:2008,newSubscribers:38}, actions:[ ["Impulsionar","Meta · prazo: 28/08"], ["Testar novo conjunto e novas peças","Meta"], ["Conversão de LP ou remarketing de WhatsApp","Meta"], ["Negativar termos de pesquisa","Google · prazo: 26/08"], ["Subir novo vídeo no YouTube","Google · prazo: 26/08"] ] },
  { key:"2026-08-31", date:"31/08/2026", meta:{leads:10,cpl:21.29,visits:231,followers:3948,newFollowers:15}, google:{leads:53,cpl:17.99,subscribers:2390,newSubscribers:382}, actions:[ ["Impulsionar","Meta · prazo: 31/08"], ["Conversão de LP ou remarketing de WhatsApp","Meta"], ["Subir novo vídeo no YouTube","Google · prazo: 04/09"] ] },
  { key:"2026-09-07", date:"07/09/2026", meta:{leads:15,cpl:14.20,visits:255,followers:4016,newFollowers:68}, google:{leads:49,cpl:19.36,subscribers:2390,newSubscribers:382}, actions:[ ["Impulsionar","Meta · prazo: 11/09"], ["Trocar peças da campanha de tráfego","Meta"], ["Conversão de LP ou remarketing de WhatsApp","Meta · faltam novas peças"], ["Subir novo vídeo no YouTube","Google · prazo: 10/09"] ] }
];

const byId = id => document.getElementById(id);
const money = value => value.toLocaleString("pt-BR", {style:"currency",currency:"BRL"});
const integer = value => value.toLocaleString("pt-BR");
const defaultAdLinks = {"2026-09-07":"https://www.instagram.com/p/Dc3CrOSj3Qd/"};
let selectedWeek = "2026-09-07";

function variation(current, previous) { return previous === undefined || previous === null || previous === 0 ? null : ((current - previous) / previous) * 100; }
function formatVariation(value) { return value === null ? "sem comparação" : `${Math.abs(value).toLocaleString("pt-BR", {minimumFractionDigits:1,maximumFractionDigits:1})}%`; }
function direction(value) { return value === null ? "sem comparação" : value > 0 ? `subiu ${formatVariation(value)}` : value < 0 ? `caiu ${formatVariation(value)}` : "ficou estável"; }
function setDelta(id, value, lowerIsBetter = false) {
  const element = byId(id), svg = element.querySelector("svg");
  element.replaceChildren(svg, document.createTextNode(formatVariation(value)));
  element.className = "delta neutral";
  if (value === null || value === 0) { svg.innerHTML = '<path d="M3 8h10"/>'; return; }
  element.className = `delta ${(lowerIsBetter ? value < 0 : value > 0) ? "good" : "bad"}`;
  svg.innerHTML = value > 0 ? '<path d="M4 10l4-4 4 4"/>' : '<path d="M4 6l4 4 4-4"/>';
}
function weekData(key) { const index = weeks.findIndex(item => item.key === key); return {data:weeks[index],previous:index > 0 ? weeks[index-1] : null}; }

function renderActions(data) {
  const list = byId("action-list"), saved = JSON.parse(localStorage.getItem(`4medic-v2-actions-${data.key}`) || "{}");
  list.replaceChildren();
  data.actions.forEach((action,index) => {
    const label = document.createElement("label"); label.className = "action-item";
    label.innerHTML = '<input type="checkbox"><span class="check-box" aria-hidden="true"></span><span><strong></strong><small></small></span>';
    label.querySelector("input").checked = Boolean(saved[index]); label.querySelector("strong").textContent = action[0]; label.querySelector("small").textContent = action[1]; list.append(label);
  });
  updatePendingCount();
}

function renderWeek(key) {
  selectedWeek = key;
  const {data,previous} = weekData(key), pm = previous?.meta, pg = previous?.google;
  const ml = variation(data.meta.leads,pm?.leads), mc = variation(data.meta.cpl,pm?.cpl), gl = variation(data.google.leads,pg?.leads), gc = variation(data.google.cpl,pg?.cpl);
  const referenced = Boolean(previous), metaGood = !referenced || (ml >= 0 && mc <= 0), googleGood = !referenced || (gl >= 0 && gc <= 0);
  byId("status-title").innerHTML = referenced ? `${metaGood ? "Meta evoluiu." : "Meta pede atenção."} <span>${googleGood ? "Google evoluiu." : "Google pede atenção."}</span>` : "Primeiro registro. <span>Base do histórico.</span>";
  byId("status-pill").textContent = !referenced ? "Referência" : metaGood && googleGood ? "Evolução" : metaGood || googleGood ? "Atenção" : "Revisar";
  byId("status-copy").textContent = referenced ? `Comparação com ${previous.date}: no Meta, leads ${direction(ml)} e CPL ${direction(mc)}; no Google, leads ${direction(gl)} e CPL ${direction(gc)}.` : "Este é o primeiro registro disponível e serve como base para a semana seguinte.";
  const values = {"meta-leads":integer(data.meta.leads),"meta-cpl":money(data.meta.cpl),"meta-visits":integer(data.meta.visits),followers:integer(data.meta.followers),"new-followers":integer(data.meta.newFollowers),"google-leads":integer(data.google.leads),"google-cpl":money(data.google.cpl),"google-subscribers":integer(data.google.subscribers),"google-new-subscribers":integer(data.google.newSubscribers)};
  Object.entries(values).forEach(([id,value]) => byId(id).textContent = value);
  setDelta("meta-leads-delta",ml); setDelta("meta-cpl-delta",mc,true); setDelta("meta-visits-delta",variation(data.meta.visits,pm?.visits)); setDelta("followers-delta",variation(data.meta.followers,pm?.followers)); setDelta("new-followers-delta",variation(data.meta.newFollowers,pm?.newFollowers));
  setDelta("google-leads-delta",gl); setDelta("google-cpl-delta",gc,true); setDelta("google-subscribers-delta",variation(data.google.subscribers,pg?.subscribers)); setDelta("google-new-subscribers-delta",variation(data.google.newSubscribers,pg?.newSubscribers));
  byId("google-insight").textContent = referenced ? `${Math.abs(data.google.leads-pg.leads)} leads ${data.google.leads >= pg.leads ? "a mais" : "a menos"}; CPL ${formatVariation(gc)} ${gc <= 0 ? "menor" : "maior"}.` : "Primeiro registro disponível para comparação.";
  [[".meta-card",metaGood],[".google-card",googleGood]].forEach(([selector,good]) => { const badge = document.querySelector(`${selector} .platform-health`); badge.textContent = referenced ? (good ? "Melhorou" : "Atenção") : "Base"; badge.className = `platform-health ${good ? "good" : "bad"}`; });
  renderActions(data); byId("quick-notes").value = localStorage.getItem(`4medic-v2-quick-notes-${key}`) || data.note || ""; renderAdLink();
}

byId("week-select").addEventListener("change", event => renderWeek(event.target.value));
const actionList = byId("action-list"), pendingCount = byId("pending-count");
function updatePendingCount() { const inputs = [...actionList.querySelectorAll("input[type='checkbox']")], pending = inputs.filter(input => !input.checked).length; pendingCount.textContent = `${pending} ${pending === 1 ? "pendente" : "pendentes"}`; }
actionList.addEventListener("change", () => { const saved = {}; [...actionList.querySelectorAll("input")].forEach((input,index) => saved[index] = input.checked); localStorage.setItem(`4medic-v2-actions-${selectedWeek}`,JSON.stringify(saved)); updatePendingCount(); });
byId("quick-action-form").addEventListener("submit", event => { event.preventDefault(); const input = byId("quick-action"), title = input.value.trim(); if (!title) return input.focus(); weekData(selectedWeek).data.actions.push([title,"Adicionada nesta reunião"]); input.value = ""; renderActions(weekData(selectedWeek).data); });
const quickNotes = byId("quick-notes"); quickNotes.addEventListener("input", () => localStorage.setItem(`4medic-v2-quick-notes-${selectedWeek}`,quickNotes.value));

const adLinkForm=byId("ad-link-form"),adLinkInput=byId("ad-link-input"),adLinkFeedback=byId("ad-link-feedback"),adOpen=byId("ad-open"),adPreviewLink=byId("ad-preview-link"),adUrlDisplay=byId("ad-url-display"),instagramFrame=byId("instagram-frame"),manualCreative=byId("manual-creative"),creativeUpload=byId("creative-upload"),clearCreativeImage=byId("clear-creative-image"),creativeStatus=byId("creative-status");
const adStorageKey=()=>`4medic-v2-ad-link-${selectedWeek}`,creativeStorageKey=()=>`4medic-v2-creative-image-${selectedWeek}`;
function getAdLink(){const stored=localStorage.getItem(adStorageKey());if(stored!==null)return stored;if(selectedWeek==="2026-09-07")return localStorage.getItem("4medic-v2-ad-link-current")||defaultAdLinks[selectedWeek];return defaultAdLinks[selectedWeek]||"";}
function shortUrl(url){if(!url)return "Nenhum link adicionado";const parsed=new URL(url);return `${parsed.hostname.replace(/^www\./,"")}${parsed.pathname}`.replace(/\/$/,"");}
function instagramEmbedUrl(url){if(!url)return "";try{const parsed=new URL(url);if(!/(^|\.)instagram\.com$/i.test(parsed.hostname))return "";const match=parsed.pathname.match(/^\/(p|reel|tv)\/([^/]+)/i);return match?`https://www.instagram.com/${match[1]}/${match[2]}/embed/`:"";}catch{return "";}}
function renderCreative(){const legacy=selectedWeek==="2026-09-07"?localStorage.getItem("4medic-v2-creative-image-current"):"",manualImage=localStorage.getItem(creativeStorageKey())||legacy||"",url=getAdLink(),embedUrl=instagramEmbedUrl(url);manualCreative.hidden=!manualImage;instagramFrame.hidden=Boolean(manualImage)||!embedUrl;adPreviewLink.hidden=Boolean(manualImage)||Boolean(embedUrl);clearCreativeImage.hidden=!manualImage;if(manualImage){manualCreative.src=manualImage;creativeStatus.textContent="Print salvo para esta semana.";creativeStatus.classList.add("success");return;}manualCreative.removeAttribute("src");creativeStatus.classList.remove("success");if(embedUrl){if(instagramFrame.src!==embedUrl)instagramFrame.src=embedUrl;creativeStatus.textContent="Carregando publicação do Instagram...";}else{instagramFrame.removeAttribute("src");creativeStatus.textContent=url?"Este link não oferece prévia do Instagram.":"Adicione um link ou envie um print.";}}
function renderAdLink(){const url=getAdLink();[adOpen,adPreviewLink,adUrlDisplay].forEach(element=>{element.setAttribute("aria-disabled",String(!url));if(url)element.href=url;else element.removeAttribute("href");});adUrlDisplay.textContent=shortUrl(url);adLinkInput.value=url;adLinkFeedback.textContent="";adLinkFeedback.classList.remove("success");adLinkForm.hidden=true;renderCreative();}
byId("edit-ad-link").addEventListener("click",()=>{adLinkForm.hidden=!adLinkForm.hidden;adLinkFeedback.textContent="";if(!adLinkForm.hidden){adLinkInput.value=getAdLink();adLinkInput.focus();adLinkInput.select();}});
adLinkForm.addEventListener("submit",event=>{event.preventDefault();const value=adLinkInput.value.trim();if(!value){adLinkFeedback.textContent="Cole um link antes de salvar.";return adLinkInput.focus();}try{const parsed=new URL(value);if(!["http:","https:"].includes(parsed.protocol))throw new Error();localStorage.setItem(adStorageKey(),parsed.href);renderAdLink();adLinkForm.hidden=false;adLinkFeedback.textContent="Link salvo para esta semana.";adLinkFeedback.classList.add("success");}catch{adLinkFeedback.textContent="Use um link completo, começando com https://";adLinkInput.focus();}});
instagramFrame.addEventListener("load",()=>{if(!instagramFrame.hidden){creativeStatus.textContent="Publicação carregada do Instagram.";creativeStatus.classList.add("success");}});
creativeUpload.addEventListener("change",()=>{const file=creativeUpload.files?.[0];if(!file)return;if(!["image/png","image/jpeg","image/webp"].includes(file.type)){creativeStatus.textContent="Use uma imagem PNG, JPG ou WebP.";creativeUpload.value="";return;}if(file.size>3*1024*1024){creativeStatus.textContent="O print deve ter no máximo 3 MB.";creativeUpload.value="";return;}const reader=new FileReader();reader.addEventListener("load",()=>{try{localStorage.setItem(creativeStorageKey(),String(reader.result));renderCreative();}catch{creativeStatus.textContent="O navegador não conseguiu salvar esta imagem. Tente um arquivo menor.";}creativeUpload.value="";});reader.readAsDataURL(file);});
clearCreativeImage.addEventListener("click",()=>{localStorage.removeItem(creativeStorageKey());if(selectedWeek==="2026-09-07")localStorage.removeItem("4medic-v2-creative-image-current");renderCreative();});

const historyDialog=byId("history-dialog");
function renderHistory(){byId("history-body").innerHTML=weeks.slice().reverse().map(item=>`<tr class="${item.key===selectedWeek?"selected":""}"><td>${item.date}</td><td>${integer(item.meta.leads)}</td><td>${money(item.meta.cpl)}</td><td>${integer(item.meta.visits)}</td><td>${integer(item.meta.followers)}</td><td>${integer(item.google.leads)}</td><td>${money(item.google.cpl)}</td></tr>`).join("");const first=weeks[0],last=weeks.at(-1);byId("history-summary").innerHTML=`<span><small>Meta leads</small><strong>${first.meta.leads} → ${last.meta.leads}</strong></span><span><small>CPL Meta</small><strong>${money(first.meta.cpl)} → ${money(last.meta.cpl)}</strong></span><span><small>Google leads</small><strong>${first.google.leads} → ${last.google.leads}</strong></span><span><small>CPL Google</small><strong>${money(first.google.cpl)} → ${money(last.google.cpl)}</strong></span>`;}
byId("history-open").addEventListener("click",()=>{renderHistory();historyDialog.showModal();});byId("history-close").addEventListener("click",()=>historyDialog.close());historyDialog.addEventListener("click",event=>{if(event.target===historyDialog)historyDialog.close();});
renderWeek(selectedWeek);
