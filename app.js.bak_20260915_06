 const x={lead:0,leadSpend:0,visits:0,trafficSpend:0,clicks:0,profile:0,webinar:0,webinarSpend:0,cadastro:0,cadastroSpend:0};let hasLead=false,hasTraffic=false;
 rows.forEach(r=>{const campaign=norm(pick(r,["nome da campanha","campanha","campaign"])),type=norm(pick(r,["tipo de resultado","result type"]));if(!campaign||/^total/.test(campaign))return;const result=numeric(pick(r,["resultados","results","conversoes","conversions"]))||0,spend=numeric(pick(r,["valor usado","valor gasto","amount spent","custo","cost"]))||0,lp=numeric(pick(r,["visualizacoes da pagina de destino","landing page views"]))||0,profile=numeric(pick(r,["visitas ao perfil","profile visits"]))||0,clicks=numeric(pick(r,["cliques no link","link clicks","cliques","clicks"]))||0,text=`${campaign} ${type}`,follower=/seguidor|follower/.test(text),tra=/trafego|traffic|visita|perfil|landing|pagina de destino/.test(text),lead=!follower&&/lead|cadastro|captacao|formulario|form|webinar|conversao/.test(text);
  if(lead){x.lead+=result;x.leadSpend+=spend;hasLead=true;if(/webinar/.test(campaign)){x.webinar+=result;x.webinarSpend+=spend}if(/cadastro/.test(campaign)){x.cadastro+=result;x.cadastroSpend+=spend}}
  if(tra||lp||profile){x.visits+=lp||profile||result;x.profile+=profile;x.clicks+=clicks;x.trafficSpend+=spend;hasTraffic=true}
 });
 return{leads:hasLead?x.lead:null,cpl:hasLead&&x.lead?x.leadSpend/x.lead:null,visits:hasTraffic?x.visits:null,costVisit:hasTraffic&&x.visits?x.trafficSpend/x.visits:null,clicks:x.clicks||null,profileVisits:x.profile||null,webinarLeads:x.webinar||null,webinarCpl:x.webinar?x.webinarSpend/x.webinar:null,cadastroLeads:x.cadastro||null,cadastroCpl:x.cadastro?x.cadastroSpend/x.cadastro:null};
}
function googleAggregate(rows){
 let leads=0,spend=0,newSubscribers=0,found=false;const totals=[];
 rows.forEach(r=>{const campaign=norm(pick(r,["campanha","campaign"])),status=norm(pick(r,["status da campanha","campaign status"])),type=norm(pick(r,["tipo de campanha","campaign type"])),conv=numeric(pick(r,["conversoes","conversions","todas as conversoes","all conversions"]))||0,cost=numeric(pick(r,["custo","cost"]))||0,subs=numeric(pick(r,["assinantes adquiridos","subscribers gained","earned subscribers"]))||0,total=/^total/.test(`${status} ${campaign}`),follower=/seguidor|subscriber|inscrito|youtube|video/.test(`${campaign} ${type}`),search=/pesquisa|search/.test(`${status} ${campaign} ${type}`);
  if(total&&search&&cost>0)totals.push(cost);if(!total&&search&&!follower){leads+=conv;spend+=cost;found=true}if(subs>newSubscribers)newSubscribers=subs
 });const actualSpend=totals.length?Math.max(...totals):spend;return{leads:found?leads:null,cpl:found&&leads?actualSpend/leads:null,newSubscribers:newSubscribers||null};
}
