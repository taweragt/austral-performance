:root {
  --ink: #10213a;
  --muted: #647187;
  --paper: #f4f7fb;
  --surface: #ffffff;
  --line: #dfe6f0;
  --blue: #2457f5;
  --brand-soft: #edf2ff;
  --blue-soft: var(--brand-soft);
  --brand-accent: #12835f;
  --brand-logo-bg: #1715ed;
  --green: #12835f;
  --green-soft: #e7f6ef;
  --red: #d84b4b;
  --red-soft: #fdecec;
  --amber: #b87813;
  --shadow: 0 15px 40px rgba(28, 48, 80, .08);
  --serif: "DM Serif Display", Georgia, serif;
  --sans: Inter, Arial, sans-serif;
  --mono: "IBM Plex Mono", Consolas, monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
button, input, select, textarea { font: inherit; }
button, select { cursor: pointer; }
svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.skip-link { position: fixed; top: -60px; left: 12px; z-index: 100; padding: 10px 14px; color: #fff; background: var(--ink); border-radius: 8px; }.skip-link:focus { top: 12px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

.theme-toggle { display: grid; place-items: center; flex: 0 0 40px; width: 40px; height: 40px; padding: 0; border: 1px solid #ead79a; border-radius: 50%; color: #a86b00; background: #fff6d5; box-shadow: inset 0 0 0 3px rgba(255,255,255,.48); transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
.theme-toggle:hover { transform: translateY(-2px) rotate(8deg); color: #865400; border-color: #d4b65b; }
.theme-toggle:focus-visible { outline: 3px solid color-mix(in srgb, var(--blue) 24%, transparent); outline-offset: 2px; }
.theme-toggle svg { width: 18px; height: 18px; }

[data-theme="dark"] {
  color-scheme: dark;
  --ink: #e9eef5;
  --muted: #9ba9ba;
  --paper: #0e141c;
  --surface: #171f2a;
  --line: #2a3645;
  --blue-soft: color-mix(in srgb, var(--blue) 17%, #171f2a);
  --green: #52c69c;
  --green-soft: #17352d;
  --red: #ff8585;
  --red-soft: #3b2428;
  --amber: #e5ad50;
  --shadow: 0 18px 44px rgba(0,0,0,.24);
}
[data-theme="dark"] .topbar { background: rgba(14,20,28,.94); }
[data-theme="dark"] .theme-toggle { color: #778497; border-color: var(--line); background: #151d27; box-shadow: none; }
[data-theme="dark"] .theme-toggle:hover { color: #aeb9c7; border-color: #465466; }
[data-theme="dark"] .import-trigger,
[data-theme="dark"] .primary-button,
[data-theme="dark"] .quick-action-form button,
[data-theme="dark"] .ad-link-form button { color: #0e141c; }
[data-theme="dark"] .ad-preview { color: #0e141c; }
[data-theme="dark"] .ad-preview em { color: color-mix(in srgb, #0e141c 76%, transparent); }
[data-theme="dark"] .metric-edit,
[data-theme="dark"] .check-box,
[data-theme="dark"] .quick-action-form input,
[data-theme="dark"] .notes-block textarea,
[data-theme="dark"] .ad-actions button,
[data-theme="dark"] .ad-actions a,
[data-theme="dark"] .ad-actions .icon-control,
[data-theme="dark"] .ad-link-form input,
[data-theme="dark"] .history-head button,
[data-theme="dark"] .budget-head button,
[data-theme="dark"] .metrics-head button,
[data-theme="dark"] .import-head button,
[data-theme="dark"] .field-group input,
[data-theme="dark"] .secondary-button { color: var(--ink); border-color: var(--line); background: #1c2632; }
[data-theme="dark"] .notes-block,
[data-theme="dark"] .history-summary span,
[data-theme="dark"] .upload-card { background: #141c26; }
[data-theme="dark"] .creative-stage,
[data-theme="dark"] .manual-creative { background: #111923; }
[data-theme="dark"] .history-head,
[data-theme="dark"] .import-head,
[data-theme="dark"] .metrics-head,
[data-theme="dark"] .budget-head,
[data-theme="dark"] .import-footer,
[data-theme="dark"] .metrics-footer,
[data-theme="dark"] .budget-footer { background: rgba(23,31,42,.97); }
[data-theme="dark"] .history-note { color: #e8c47f; background: #302719; }
[data-theme="dark"] .import-feedback { color: var(--ink); }
[data-theme="dark"] .database-status[data-state="busy"] { color: #e8c47f; border-color: #5f512f; background: #302719; }
[data-theme="dark"] input::placeholder,
[data-theme="dark"] textarea::placeholder { color: #718095; }

.topbar { min-height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 12px clamp(18px, 4vw, 58px); border-bottom: 2px solid color-mix(in srgb, var(--brand-accent) 45%, var(--line)); background: rgba(244,247,251,.94); backdrop-filter: blur(14px); }
.brand { display: flex; align-items: center; gap: 11px; color: inherit; text-decoration: none; }.brand-mark { display: grid; place-items: center; width: 58px; height: 42px; padding: 3px; overflow: hidden; background: var(--brand-logo-bg); border: 1px solid color-mix(in srgb, var(--blue) 18%, var(--line)); border-radius: 10px; box-shadow: 0 0 0 5px color-mix(in srgb, var(--blue) 9%, transparent); transition: background .25s ease, border-color .25s ease; }.brand-mark img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--logo-x, 50%) var(--logo-y, 50%); border-radius: 6px; transform: scale(var(--logo-scale, 1)); transition: transform .25s ease, object-position .25s ease; }.brand-copy strong,.brand-copy small { display: block; }.brand-copy strong { font-size: 15px; line-height: 1; }.brand small { max-width: 112px; margin-top: 4px; color: var(--muted); font-size: 8px; font-weight: 700; line-height: 1.2; text-transform: uppercase; letter-spacing: .08em; }
.filters { display: flex; gap: 10px; }.filters label { display: flex; align-items: center; gap: 8px; }.filters label > span { color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }.filters select { height: 40px; min-width: 132px; padding: 0 34px 0 12px; border: 1px solid var(--line); border-radius: 9px; color: var(--ink); background: var(--surface); font-size: 11px; font-weight: 700; outline: none; }.filters select:focus-visible { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(36,87,245,.12); }
.budget-strip { display: flex; align-items: center; gap: 12px; margin-right: 4px; padding-right: 14px; border-right: 1px solid var(--line); }.budget-strip span { color: var(--muted); font-size: 8px; text-transform: uppercase; letter-spacing: .06em; }.budget-strip strong { display: block; margin-top: 2px; color: var(--ink); font-family: var(--mono); font-size: 10px; letter-spacing: 0; text-transform: none; }.budget-edit { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 1px solid color-mix(in srgb, var(--blue) 24%, var(--line)); border-radius: 8px; color: var(--blue); background: var(--blue-soft); }.budget-edit svg { width: 14px; height: 14px; }.budget-edit:hover { color: #fff; background: var(--blue); }.budget-trigger-mobile { display: none; }.history-trigger { height: 40px; padding: 0 13px; border: 1px solid #cbd7f6; border-radius: 9px; color: var(--blue); background: var(--blue-soft); font-size: 9px; font-weight: 800; transition: transform .2s ease, color .2s ease, background .2s ease; }.history-trigger:hover { transform: translateY(-2px); color: #fff; background: var(--blue); }

.meeting-sheet { max-width: 1400px; margin: 0 auto; padding: 26px clamp(18px, 4vw, 58px) 18px; }
.account-status { position: relative; display: grid; grid-template-columns: auto minmax(260px,.8fr) minmax(340px,1.2fr) auto; align-items: center; gap: 18px; min-height: 92px; padding: 18px 20px; overflow: hidden; border: 1px solid #d9e2f1; border-radius: 16px; background: var(--surface); box-shadow: inset 4px 0 0 var(--brand-accent), var(--shadow); animation: enter .4s ease both; }
.status-signal { display: flex; align-items: end; gap: 3px; width: 28px; height: 32px; padding: 5px; border-radius: 8px; background: var(--red-soft); }.status-signal span { width: 4px; border-radius: 4px; background: var(--red); animation: pulse 1.8s ease-in-out infinite; }.status-signal span:nth-child(1) { height: 9px; }.status-signal span:nth-child(2) { height: 20px; animation-delay: .16s; }.status-signal span:nth-child(3) { height: 13px; animation-delay: .32s; }
.overline { margin: 0 0 4px; color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }.account-status h1 { margin: 0; font-family: var(--serif); font-size: clamp(23px, 2.3vw, 32px); font-weight: 400; line-height: 1.05; }.account-status h1 span { color: var(--green); }.account-status > p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.55; }.status-pill { justify-self: end; padding: 7px 11px; color: var(--red); background: var(--red-soft); border: 1px solid #f6cccc; border-radius: 999px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }

.overview-grid { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 16px; margin-top: 16px; }.work-column { min-width: 0; display: grid; gap: 16px; }.platforms { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }.platform-card, .meeting-notes, .ad-week { border: 1px solid var(--line); background: var(--surface); border-radius: 16px; box-shadow: var(--shadow); }
.platforms.single .meta-card { grid-column: 1 / -1; }
.brand-mark .text-mark { color: #fff; font-family: var(--mono); font-size: 13px; font-weight: 800; letter-spacing: -.04em; }
.platform-card[hidden], .upload-card[hidden], .field-group[hidden], .budget-strip span[hidden] { display: none !important; }
.platform-card { padding: 18px; transition: transform .2s ease, border-color .2s ease; animation: enter .45s ease both; }.platform-card:hover { transform: translateY(-2px); border-color: #bac8de; }.platform-card header, .ad-heading, .section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }.platform-name { display: flex; align-items: center; gap: 10px; }.platform-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; color: var(--blue); background: var(--blue-soft); font-family: var(--mono); font-size: 12px; font-weight: 700; }.platform-name p, .platform-name small { display: block; margin: 0; }.platform-name p { font-size: 13px; font-weight: 800; }.platform-name small { margin-top: 3px; color: var(--muted); font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }.platform-health { padding: 6px 8px; border-radius: 999px; font-size: 8px; font-weight: 800; text-transform: uppercase; }.platform-health.good { color: var(--green); background: var(--green-soft); }.platform-health.bad { color: var(--red); background: var(--red-soft); }
.platform-tools { display: flex; align-items: center; gap: 6px; }.metric-edit { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 1px solid var(--line); border-radius: 8px; color: var(--muted); background: #fff; transition: transform .2s ease, color .2s ease, border-color .2s ease; }.metric-edit svg { width: 14px; height: 14px; }.metric-edit:hover { transform: translateY(-2px); color: var(--blue); border-color: #b7c6fa; }.metric-edit:focus-visible { outline: 3px solid rgba(36,87,245,.16); outline-offset: 2px; }
.metric-list { margin-top: 14px; border-top: 1px solid var(--line); }.metric-row { display: grid; grid-template-columns: minmax(110px,1fr) auto 68px; align-items: center; gap: 10px; min-height: 50px; border-bottom: 1px solid var(--line); }.metric-row:last-child { border-bottom: 0; }.metric-row > span { color: var(--muted); font-size: 10px; font-weight: 600; }.metric-row strong { font-family: var(--mono); font-size: 17px; letter-spacing: -.04em; }.metric-row.emphasis strong { font-size: 25px; color: var(--ink); }.delta { display: inline-flex; align-items: center; justify-content: flex-end; font-family: var(--mono); font-size: 10px; font-style: normal; font-weight: 700; }.delta svg { width: 13px; height: 13px; }.delta.good { color: var(--green); }.delta.bad { color: var(--red); }.delta.neutral { color: var(--amber); }.plain-insight { margin: 12px 0 0; padding: 10px 12px; border-left: 3px solid var(--red); color: #844040; background: var(--red-soft); font-size: 10px; font-weight: 700; line-height: 1.4; }

.meeting-notes { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(230px,.75fr); gap: 0; overflow: hidden; animation: enter .5s ease both; }.actions-block, .notes-block { padding: 16px 18px; }.notes-block { border-left: 1px solid var(--line); background: #f9fbfe; }.section-title h2, .ad-heading h2 { margin: 0; font-family: var(--serif); font-size: 23px; font-weight: 400; }.section-title > span { padding: 5px 8px; color: var(--muted); background: var(--paper); border-radius: 999px; font-size: 8px; font-weight: 700; }.action-list { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 12px; margin-top: 12px; }.action-item { position: relative; display: flex; align-items: center; gap: 9px; min-height: 39px; cursor: pointer; }.action-item input { position: absolute; opacity: 0; pointer-events: none; }.check-box { position: relative; flex: 0 0 20px; width: 20px; height: 20px; border: 1.5px solid #adb9ca; border-radius: 5px; background: #fff; transition: background .2s ease, border-color .2s ease, transform .2s ease; }.action-item:hover .check-box { transform: scale(1.06); border-color: var(--blue); }.action-item input:focus-visible + .check-box { box-shadow: 0 0 0 3px rgba(36,87,245,.14); }.action-item input:checked + .check-box { border-color: var(--green); background: var(--green); }.action-item input:checked + .check-box::after { position: absolute; top: 3px; left: 6px; width: 5px; height: 9px; content: ""; border-right: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(45deg); }.action-item input:checked ~ span strong { color: var(--muted); text-decoration: line-through; }.action-item strong, .action-item small { display: block; }.action-item strong { font-size: 10px; }.action-item small { margin-top: 2px; color: var(--muted); font-size: 8px; }
.quick-action-form { display: flex; margin-top: 9px; }.quick-action-form input { min-width: 0; flex: 1; height: 34px; padding: 0 10px; border: 1px solid var(--line); border-right: 0; border-radius: 8px 0 0 8px; color: var(--ink); background: #fff; font-size: 9px; outline: none; }.quick-action-form input:focus { border-color: var(--blue); }.quick-action-form button { display: grid; place-items: center; width: 38px; border: 0; border-radius: 0 8px 8px 0; color: #fff; background: var(--blue); transition: transform .2s ease, background .2s ease; }.quick-action-form button:hover { background: #153fc9; }.quick-action-form button:active { transform: scale(.95); }.quick-action-form svg { width: 16px; height: 16px; }
.notes-block textarea { width: 100%; height: 85px; resize: none; margin-top: 12px; padding: 10px; border: 1px dashed #c6d0df; border-radius: 9px; color: var(--ink); background: #fff; font-size: 10px; line-height: 1.5; outline: none; }.notes-block textarea:focus { border-style: solid; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(36,87,245,.1); }.notes-block > small { display: block; margin-top: 5px; color: #8d98aa; font-size: 7px; }

.ad-week { grid-row: span 1; padding: 18px; animation: enter .48s ease both; }.ad-actions { display: flex; gap: 5px; }.ad-actions button, .ad-actions a, .ad-actions .icon-control { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 1px solid var(--line); border-radius: 9px; color: var(--ink); background: #fff; cursor: pointer; transition: transform .2s ease, color .2s ease, border-color .2s ease; }.ad-actions button:hover, .ad-actions a:hover, .ad-actions .icon-control:hover { transform: translateY(-2px); color: var(--blue); border-color: #b7c6fa; }.ad-actions button:focus-visible, .ad-actions a:focus-visible, .ad-actions .icon-control:focus-within { outline: 3px solid rgba(36,87,245,.16); outline-offset: 2px; }.ad-actions a[aria-disabled="true"] { pointer-events: none; opacity: .38; }.icon-control input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }.creative-stage { position: relative; height: 285px; margin-top: 14px; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: #f8fafc; }.instagram-frame, .manual-creative, .ad-preview { position: absolute; inset: 0; width: 100%; }.instagram-frame { height: 430px; border: 0; background: #fff; }.manual-creative { height: 100%; object-fit: cover; background: #eef2f8; }.ad-preview { display: block; height: 100%; padding: 20px; overflow: hidden; color: #fff; background: var(--blue); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }.ad-preview:hover { transform: scale(1.015); box-shadow: 0 12px 26px rgba(36,87,245,.22); }.ad-preview:focus-visible { outline: 3px solid rgba(36,87,245,.22); outline-offset: -4px; }.ad-preview[aria-disabled="true"] { pointer-events: none; }.ad-preview::before, .ad-preview::after { position: absolute; content: ""; border: 24px solid rgba(255,255,255,.12); border-radius: 50%; }.ad-preview::before { width: 180px; height: 180px; top: -75px; right: -90px; }.ad-preview::after { width: 130px; height: 130px; right: -88px; bottom: 18px; }.ad-preview > span { font-size: 9px; font-weight: 800; letter-spacing: .08em; }.ad-preview > strong { position: relative; z-index: 1; display: block; margin-top: 46px; font-family: var(--serif); font-size: 27px; font-weight: 400; line-height: .95; }.ad-preview em { font-style: normal; color: #d9e2ff; }.ad-preview > small { position: absolute; bottom: 15px; left: 20px; font-size: 7px; text-transform: uppercase; letter-spacing: .08em; opacity: .75; }.ad-lines { position: absolute; right: 18px; bottom: 29px; width: 84px; padding: 12px; border: 1px solid rgba(255,255,255,.35); transform: rotate(-5deg); }.ad-lines i { display: block; height: 4px; margin: 5px 0; border-radius: 4px; background: rgba(255,255,255,.75); }.ad-lines i:nth-child(2) { width: 75%; }.ad-lines i:nth-child(3) { width: 45%; }.creative-status { min-height: 12px; margin: 5px 0 0; color: var(--muted); font-size: 7px; }.creative-status.success { color: var(--green); }
.ad-meta { margin: 9px 0 0; }.ad-meta div { display: flex; align-items: center; justify-content: space-between; min-height: 27px; border-bottom: 1px solid var(--line); }.ad-meta dt { color: var(--muted); font-size: 8px; }.ad-meta dd { margin: 0; font-size: 9px; font-weight: 700; }.ad-meta dd span { display: inline-block; width: 6px; height: 6px; margin-right: 3px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px rgba(18,131,95,.1); }.creative-link { display: grid; gap: 3px; padding: 8px 0; border-bottom: 1px solid var(--line); }.creative-link > span { color: var(--muted); font-size: 8px; }.creative-link a { max-width: 100%; overflow: hidden; color: var(--blue); font-size: 8px; font-weight: 700; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }.creative-link a:hover { text-decoration: underline; }.creative-link a[aria-disabled="true"] { color: var(--muted); pointer-events: none; }.ad-link-form { margin-top: 8px; padding: 9px; border: 1px solid #cbd7f6; border-radius: 9px; background: var(--blue-soft); }.ad-link-form[hidden] { display: none; }.ad-link-form > label { display: block; margin-bottom: 6px; color: var(--ink); font-size: 8px; font-weight: 700; }.ad-link-form > div { display: flex; }.ad-link-form input { min-width: 0; flex: 1; height: 31px; padding: 0 8px; border: 1px solid #b9c7ec; border-right: 0; border-radius: 7px 0 0 7px; color: var(--ink); background: #fff; font-size: 8px; outline: none; }.ad-link-form input:focus { border-color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue); }.ad-link-form button { padding: 0 10px; border: 0; border-radius: 0 7px 7px 0; color: #fff; background: var(--blue); font-size: 8px; font-weight: 800; transition: background .2s ease, transform .2s ease; }.ad-link-form button:hover { background: #153fc9; }.ad-link-form button:active { transform: scale(.97); }.ad-link-form > small { display: block; min-height: 11px; margin-top: 4px; color: var(--red); font-size: 7px; }.ad-link-form > small.success { color: var(--green); }.ad-week > p { margin: 7px 0 0; color: var(--muted); font-size: 7px; line-height: 1.4; }
.page-footer { max-width: 1400px; display: flex; justify-content: space-between; gap: 20px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 58px) 18px; color: #8d98aa; font-family: var(--mono); font-size: 8px; }
